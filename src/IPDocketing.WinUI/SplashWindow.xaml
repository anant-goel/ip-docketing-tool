<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IPDocketing.WinUI.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#FF080B12">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
            <Border Width="64" Height="64" CornerRadius="16" Background="#FF243149"
                    HorizontalAlignment="Center">
                <TextBlock Text="IP" FontSize="26" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="IP Docketing" FontSize="20" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" />
            <ProgressRing IsActive="True" Width="28" Height="28" HorizontalAlignment="Center" />
            <TextBlock x:Name="StatusText" Text="Starting up..." FontSize="12" Foreground="#9EA8BA"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
