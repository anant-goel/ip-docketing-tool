<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IPDocketing.WinUI.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Deliberately self-contained: no StaticResource lookups, no acrylic, no
         theme dictionary. This window has to paint before anything else in the
         app is initialised, so every resource it depends on is one more thing
         that can leave it blank. Literal colours only. -->
    <Grid x:Name="RootPanel" Background="#FF080B12">
        <Border BorderBrush="#26FFFFFF" BorderThickness="1" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <Border Width="64" Height="64" CornerRadius="18" HorizontalAlignment="Center"
                    BorderBrush="#59FFFFFF" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FF73A2FF" Offset="0" />
                        <GradientStop Color="#FF3F6FE8" Offset="0.52" />
                        <GradientStop Color="#FF315AC6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="IP" FontSize="26" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="IP Docketing" FontSize="20" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" />

            <ProgressBar x:Name="Progress" Width="200" Height="3" IsIndeterminate="True"
                         Foreground="#FF5B8CFF" Background="#1AFFFFFF"
                         HorizontalAlignment="Center" />

            <TextBlock x:Name="StatusText" Text="Starting up..." FontSize="12" Foreground="#9EA8BA"
                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="300"
                       TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Window>
