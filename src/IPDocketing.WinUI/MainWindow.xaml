<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IPDocketing.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="IP Docketing | By Anant Goel">

    <Grid x:Name="RootGrid" Background="Transparent">

        <Grid.Resources>
            <!--
                The colour field, and why it moves.

                Glass is only legible as glass when there is something behind it
                worth refracting. Two static orbs at 0.72 gave the acrylic a flat
                gradient to sample, so every panel sampled roughly the same colour
                every time and the result read as tinted paint no matter how
                translucent the brush was.

                Three orbs now drift and breathe on long, offset cycles. Nothing
                here is fast enough to notice directly - the shortest leg is 28
                seconds - but it means the colour under a card is never quite the
                colour under the card beside it, and it shifts as you work. That
                difference is most of what separates Apple's material from a
                blurred screenshot.

                All four animated properties are transforms, so these run on the
                composition thread and cost no layout or paint work on the UI
                thread. Duration and travel are the two knobs worth touching if
                it ever feels busy.
            -->
            <Storyboard x:Key="AmbientDrift" RepeatBehavior="Forever" AutoReverse="True">
                <DoubleAnimation Storyboard.TargetName="OrbAzure"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                                 From="0" To="180" Duration="0:0:34" />
                <DoubleAnimation Storyboard.TargetName="OrbAzure"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                                 From="0" To="90" Duration="0:0:46" />
                <DoubleAnimation Storyboard.TargetName="OrbAzure"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                                 From="1" To="1.18" Duration="0:0:40" />
                <DoubleAnimation Storyboard.TargetName="OrbAzure"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                 From="1" To="1.18" Duration="0:0:40" />

                <DoubleAnimation Storyboard.TargetName="OrbViolet"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                                 From="0" To="-220" Duration="0:0:52" />
                <DoubleAnimation Storyboard.TargetName="OrbViolet"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                                 From="0" To="-140" Duration="0:0:38" />
                <DoubleAnimation Storyboard.TargetName="OrbViolet"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                                 From="1.12" To="0.94" Duration="0:0:44" />
                <DoubleAnimation Storyboard.TargetName="OrbViolet"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                 From="1.12" To="0.94" Duration="0:0:44" />

                <DoubleAnimation Storyboard.TargetName="OrbTeal"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateX)"
                                 From="0" To="140" Duration="0:0:28" />
                <DoubleAnimation Storyboard.TargetName="OrbTeal"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                                 From="0" To="-180" Duration="0:0:50" />
                <DoubleAnimation Storyboard.TargetName="OrbTeal"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleX)"
                                 From="0.92" To="1.22" Duration="0:0:36" />
                <DoubleAnimation Storyboard.TargetName="OrbTeal"
                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.ScaleY)"
                                 From="0.92" To="1.22" Duration="0:0:36" />
            </Storyboard>
        </Grid.Resources>

        <Canvas IsHitTestVisible="False" Opacity="0.9">
            <Ellipse x:Name="OrbAzure" Width="760" Height="760"
                     Canvas.Left="-280" Canvas.Top="-320"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#6B5B8CFF" Offset="0" />
                        <GradientStop Color="#2E5B8CFF" Offset="0.55" />
                        <GradientStop Color="#005B8CFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <Ellipse x:Name="OrbViolet" Width="880" Height="880"
                     Canvas.Left="920" Canvas.Top="300"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#5E8A7DFF" Offset="0" />
                        <GradientStop Color="#268A7DFF" Offset="0.58" />
                        <GradientStop Color="#008A7DFF" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>

            <!-- A third, cooler pole. Two orbs of similar hue average out to one
                 wash; a third at a distance is what keeps the field from looking
                 like a single gradient. -->
            <Ellipse x:Name="OrbTeal" Width="620" Height="620"
                     Canvas.Left="380" Canvas.Top="620"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <CompositeTransform />
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#4A35D0B8" Offset="0" />
                        <GradientStop Color="#1C35D0B8" Offset="0.6" />
                        <GradientStop Color="#0035D0B8" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- The band of light along the top edge of the window, where a real
             sheet of glass catches the sky. Cheap, static, and does more for the
             "pane of glass" read than any amount of extra blur. -->
        <Rectangle Height="220" VerticalAlignment="Top" IsHitTestVisible="False"
                   Fill="{StaticResource VibrantSheenBrush}" Opacity="0.55" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Padding="18,0,160,0" Background="Transparent">
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Border Width="25" Height="25" CornerRadius="8"
                            Background="{StaticResource LiquidPrimaryBrush}"
                            BorderBrush="{StaticResource LiquidEdgeBrush}" BorderThickness="1">
                        <TextBlock Text="IP" FontSize="10" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="IP Docketing | By Anant Goel" FontFamily="Segoe UI Variable Display"
                               FontWeight="SemiBold" FontSize="13"
                               Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource PillBadgeStyle}" Padding="8,3">
                        <TextBlock Text="LOCAL" FontSize="9" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextTertiaryBrush}" CharacterSpacing="90" />
                    </Border>
                </StackPanel>
            </Grid>

            <NavigationView
                x:Name="NavView"
                Grid.Row="1"
                Background="Transparent"
                PaneDisplayMode="Left"
                IsBackButtonVisible="Collapsed"
                IsSettingsVisible="True"
                IsPaneToggleButtonVisible="True"
                IsPaneOpen="True"
                OpenPaneLength="252"
                CompactPaneLength="52"
                SelectionFollowsFocus="Disabled"
                SelectionChanged="NavView_SelectionChanged"
                Loaded="NavView_Loaded">

                <NavigationView.PaneHeader>
                    <TextBlock Text="WORKSPACE" Margin="8,10,0,12" FontSize="10"
                               CharacterSpacing="110" Foreground="{ThemeResource TextTertiaryBrush}" />
                </NavigationView.PaneHeader>

                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Dashboard" Tag="Dashboard" IsSelected="True">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Matters" Tag="Matters">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C3;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Deadlines" Tag="Deadlines">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Oppositions" Tag="Oppositions">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Automation" Tag="Automation">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE9F5;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Renewals" Tag="Renewals">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE823;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Status Tracker" Tag="StatusTracker">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="TM Search" Tag="TrademarkSearch">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE721;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Journal Watch" Tag="Journal">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Client Updates" Tag="ClientUpdates">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE715;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Activity Log" Tag="ActivityLog">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="IP India Portal" Tag="IpIndiaPortal">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Calendar" Tag="Calendar">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE163;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="PTO Sync" Tag="PtoSync">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE895;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Documents" Tag="Documents">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8A5;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Reports" Tag="Reports">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <NavigationView.PaneFooter>
                    <Border Margin="8,12,8,14" Padding="11,9" CornerRadius="14"
                            Background="{ThemeResource GlassInputBrush}"
                            BorderBrush="{StaticResource VibrantRimBrush}" BorderThickness="1.25">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Encrypted local workspace" FontSize="11"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </NavigationView.PaneFooter>

                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Margin="12,8,16,8" Style="{StaticResource VibrantPanelStyle}" CornerRadius="18">
                        <Grid Padding="16,0" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <AutoSuggestBox x:Name="SearchBox" Width="360" MaxWidth="520"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            PlaceholderText="Search matters and deadlines"
                                            QuerySubmitted="SearchBox_QuerySubmitted"
                                            Background="{ThemeResource GlassInputBrush}"
                                            BorderBrush="{ThemeResource GlassHairlineBrush}">
                                <AutoSuggestBox.QueryIcon>
                                    <SymbolIcon Symbol="Find" />
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="DateText" HorizontalAlignment="Right" FontSize="12"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="Database ready" HorizontalAlignment="Right" FontSize="10"
                                               Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                                <Button x:Name="NotificationButton"
                                        Style="{StaticResource GlassButtonStyle}"
                                        Padding="12,8"
                                        Click="NotificationButton_Click"
                                        ToolTipService.ToolTip="Open deadline reminders">
                                    <Grid ColumnSpacing="7">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xEA8F;" FontSize="15" />
                                        <Border x:Name="ReminderBadge"
                                                Grid.Column="1"
                                                MinWidth="20"
                                                Height="20"
                                                Padding="5,0"
                                                CornerRadius="10"
                                                Background="{StaticResource DangerBrush}">
                                            <TextBlock x:Name="ReminderCountText"
                                                       Text="0"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button Content="Quick docket" Style="{StaticResource LiquidButtonStyle}"
                                        Click="QuickDocket_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <InfoBar x:Name="ReminderInfoBar"
                             Grid.Row="1"
                             Margin="12,0,16,8"
                             IsOpen="False"
                             IsClosable="True"
                             Severity="Warning"
                             Title="Deadline reminder">
                        <InfoBar.ActionButton>
                            <Button Content="View calendar"
                                    Style="{StaticResource GlassButtonStyle}"
                                    Click="ReminderView_Click" />
                        </InfoBar.ActionButton>
                    </InfoBar>

                    <Frame x:Name="ContentFrame" Grid.Row="2" Background="Transparent">
                        <!-- Pages slide and fade in rather than snapping. On a
                             translucent shell a hard cut is jarring: the whole
                             window is one continuous surface, so content should
                             arrive onto it rather than replace it. -->
                        <Frame.ContentTransitions>
                            <TransitionCollection>
                                <NavigationThemeTransition>
                                    <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                        <SlideNavigationTransitionInfo Effect="FromRight" />
                                    </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                </NavigationThemeTransition>
                            </TransitionCollection>
                        </Frame.ContentTransitions>
                    </Frame>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
