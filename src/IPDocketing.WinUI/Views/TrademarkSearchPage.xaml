<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.TrademarkSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- docx section 6: word and device marks, four match modes, three extra
         search axes, then filtered by status and by any alert on the TMR
         status page. -->
    <Grid Padding="30,24,30,30" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Trademark Search" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Searches the marks recorded in this docket — not the IP India register. Use the IP India Portal page for the register itself."
                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Style="{StaticResource PillBadgeStyle}" VerticalAlignment="Center">
                    <TextBlock x:Name="ResultCountText" Text="0 results"
                               Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
                </Border>
                <Button Content="Export results" Style="{StaticResource MergedGlassButtonBaseStyle}" Click="Export_Click" />
            </StackPanel>
        </Grid>

        <!-- Mark query -->
        <Border Grid.Row="1" Style="{StaticResource GlassSurfaceCompactStyle}">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="MarkBox" PlaceholderText="Mark text — e.g. QUICKBRITE"
                             Header="Mark" KeyDown="MarkBox_KeyDown" />
                    <ComboBox x:Name="ModeBox" Grid.Column="1" Header="Match" MinWidth="150" SelectedIndex="0">
                        <ComboBoxItem Content="Contains" Tag="Contains" />
                        <ComboBoxItem Content="Exact match" Tag="Exact" />
                        <ComboBoxItem Content="Starts with" Tag="StartsWith" />
                        <ComboBoxItem Content="Phonetic" Tag="Phonetic" />
                    </ComboBox>
                    <ComboBox x:Name="MarkTypeBox" Grid.Column="2" Header="Mark type" MinWidth="150" SelectedIndex="0">
                        <ComboBoxItem Content="Word and device" Tag="" />
                        <ComboBoxItem Content="Word mark" Tag="Word" />
                        <ComboBoxItem Content="Device mark" Tag="Device" />
                    </ComboBox>
                    <Button Grid.Column="3" Content="Search" Style="{StaticResource MergedAccentButtonStyle}"
                            VerticalAlignment="Bottom" Click="Search_Click" />
                </Grid>

                <!-- Additional search axes from the spec -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ProprietorBox" Header="Proprietor" PlaceholderText="Proprietor name"
                             KeyDown="MarkBox_KeyDown" />
                    <TextBox x:Name="AttorneyBox" Grid.Column="1" Header="Attorney / agent"
                             PlaceholderText="Attorney of record" KeyDown="MarkBox_KeyDown" />
                    <TextBox x:Name="StateBox" Grid.Column="2" Header="State" PlaceholderText="e.g. Himachal Pradesh"
                             KeyDown="MarkBox_KeyDown" />
                    <TextBox x:Name="ClassBox" Grid.Column="3" Header="Class" PlaceholderText="e.g. 25"
                             KeyDown="MarkBox_KeyDown" />
                    <Button Grid.Column="4" Content="Clear" Style="{StaticResource MergedGlassButtonBaseStyle}"
                            VerticalAlignment="Bottom" Click="Clear_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- Result filters -->
        <Border Grid.Row="2" Style="{StaticResource GlassSurfaceCompactStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Filter results" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <ComboBox x:Name="StatusFilterBox" Grid.Column="1" MinWidth="170"
                          PlaceholderText="Any status" SelectionChanged="Filter_Changed" />
                <ComboBox x:Name="AlertFilterBox" Grid.Column="2" MinWidth="210"
                          PlaceholderText="Any alert" SelectionChanged="Filter_Changed" />
                <CheckBox x:Name="OnlyAlertsCheck" Grid.Column="3" Content="Only marks with an alert"
                          VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                <TextBlock x:Name="FilterNoteText" Grid.Column="4" VerticalAlignment="Center" FontSize="11"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextTertiaryBrush}"
                           Text="Alert text is whatever you recorded from the TMR status page on the matter record." />
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource GlassSurfaceStyle}" Padding="6">
            <Grid>
                <ListView x:Name="ResultList" Background="Transparent" SelectionMode="Single"
                          DoubleTapped="ResultList_DoubleTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,12" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="12"
                                        Background="{ThemeResource GlassInputBrush}"
                                        BorderBrush="{StaticResource IridescentRimBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding MarkTypeGlyph}" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Identity}" FontSize="11"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Proprietor}" FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding Attorney}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding State}" FontSize="12"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding ClassLabel}" FontSize="11"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                </StackPanel>
                                <Border Grid.Column="4" Style="{StaticResource PillBadgeStyle}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <Border Grid.Column="5" Style="{StaticResource PillBadgeStyle}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Visibility="{Binding AlertVisibility}">
                                    <TextBlock Text="{Binding Alert}" FontSize="11" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource DangerBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="64" Height="64" CornerRadius="24"
                            Background="{ThemeResource GlassInputBrush}"
                            BorderBrush="{StaticResource IridescentRimBrush}" BorderThickness="1">
                        <FontIcon Glyph="&#xE721;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock x:Name="EmptyTitleText" Text="Search the portfolio" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="EmptyBodyText" HorizontalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="460" TextAlignment="Center"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="Enter a mark, or leave it blank and press Search to list everything, then narrow with the filters." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
