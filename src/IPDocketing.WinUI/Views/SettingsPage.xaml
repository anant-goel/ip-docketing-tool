<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <ScrollViewer Padding="28,20,28,40">
        <StackPanel Spacing="14" MaxWidth="920" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Encrypted backups, API credentials, audit integrity, and materials."
                       Style="{StaticResource SubtitleStyle}" />

            <!-- Appearance -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Appearance" FontWeight="SemiBold" FontSize="16"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="Dark matches the Liquid Glass design and is the default. Light, Colorful and System are also supported." />
                    <ComboBox x:Name="ThemeBox" Header="Theme" HorizontalAlignment="Stretch"
                              SelectionChanged="ThemeBox_SelectionChanged">
                        <ComboBoxItem Content="Dark" Tag="Dark" />
                        <ComboBoxItem Content="Light" Tag="Light" />
                        <ComboBoxItem Content="Colorful" Tag="Colorful" />
                        <ComboBoxItem Content="Match system" Tag="System" />
                    </ComboBox>
                    <TextBlock x:Name="ThemeRestartNote" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource WarningBrush}" Visibility="Collapsed"
                               Text="Colorful is an accent palette layered on the dark base, not a separate light/dark mode." />
                </StackPanel>
            </Border>

            <!-- Backups -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Encrypted backups" FontWeight="SemiBold" FontSize="16"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="Automatic encrypted snapshots every minute (DPAPI, Windows-user locked). Older than 4 days are removed. App updates never overwrite %LocalAppData%\IPDocketing." />
                    <TextBlock x:Name="BackupStatusText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <TextBlock x:Name="BackupFolderText" FontSize="11"
                               Foreground="{ThemeResource TextTertiaryBrush}" IsTextSelectionEnabled="True" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Backup now" Style="{StaticResource LiquidButtonStyle}" Click="BackupNow_Click" />
                        <Button Content="Open backup folder" Style="{StaticResource GlassButtonStyle}" Click="OpenFolder_Click" />
                        <Button Content="Refresh" Style="{StaticResource GlassButtonStyle}" Click="RefreshBackups_Click" />
                        <!-- BackupService.RestoreFrom existed but had no caller,
                             so backups could be taken and never restored - which
                             makes the whole backup feature decorative. -->
                        <Button Content="Restore selected..." Style="{StaticResource MergedGlassButtonBaseStyle}"
                                Click="RestoreBackup_Click" />
                    </StackPanel>
                    <TextBlock Text="Recent backups" FontWeight="SemiBold" FontSize="13" Margin="0,6,0,0"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <ListView x:Name="BackupList" MaxHeight="140" SelectionMode="Single"
                              Background="Transparent" BorderThickness="0" />
                </StackPanel>
            </Border>

            <!-- API keys -->
            <Border Style="{StaticResource GlassSurfaceStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="OCR engine" FontWeight="SemiBold" FontSize="16"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="Documents are read text-layer first (exact), then by OCR only for pages that have none. Tesseract is markedly better than the built-in Windows engine on the display type and coined words a trademark journal is full of." />
                    <Border Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Left">
                        <TextBlock x:Name="OcrEngineText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" Text="Checking..." />
                    </Border>
                    <TextBlock x:Name="OcrPathText" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Locate tesseract.exe..." Style="{StaticResource MergedGlassButtonBaseStyle}"
                                Click="ChooseTesseract_Click" />
                        <Button Content="Where do I get it?" Style="{StaticResource MergedGlassButtonBaseStyle}"
                                Click="TesseractHelp_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Gmail OTP credentials. This was the missing piece: the app looks
                 for gmail_client_secret.json in its data folder, but nothing in
                 the UI said so, told you where the folder was, or let you put
                 the file there. A required setup step with no visible affordance
                 is indistinguishable from a broken feature. -->
            <Border Style="{StaticResource GlassSurfaceStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Gmail OTP auto-fill" FontWeight="SemiBold" FontSize="16"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="Lets the app read the IP India OTP out of your own inbox so you don't retype it. It needs a Google OAuth client JSON, which only you can create — Google issues it to you, not to this app. Read-only Gmail scope; the file and the token never leave this machine." />
                    <Border x:Name="GmailStatusBorder" Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Left">
                        <TextBlock x:Name="GmailStatusText" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" Text="Checking..." />
                    </Border>
                    <TextBlock x:Name="GmailPathText" FontSize="11" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               Foreground="{ThemeResource TextTertiaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Choose credentials file..." Style="{StaticResource MergedAccentButtonStyle}"
                                Click="ChooseGmailCredentials_Click" />
                        <Button Content="Open data folder" Style="{StaticResource MergedGlassButtonBaseStyle}"
                                Click="OpenGmailFolder_Click" />
                        <Button Content="Setup steps" Style="{StaticResource MergedGlassButtonBaseStyle}"
                                Click="GmailHelp_Click" />
                        <Button Content="Remove" Style="{StaticResource MergedGlassButtonBaseStyle}"
                                Click="RemoveGmailCredentials_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="API keys (encrypted at rest)" FontWeight="SemiBold" FontSize="16"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="Stored as api-keys.enc under LocalAppData — only your Windows account can decrypt. Values are never written to the audit trail." />

                    <TextBlock Text="USPTO (ODP / TSDR)" FontWeight="SemiBold" FontSize="13" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"
                               Text="Get keys: https://account.uspto.gov → Developer Hub / Open Data Portal → register an application. Docs: https://developer.uspto.gov" />
                    <TextBox x:Name="UsptoClientIdBox" PlaceholderText="Client ID" Style="{StaticResource GlassTextBoxStyle}" />
                    <TextBox x:Name="UsptoApiKeyBox" PlaceholderText="API Key" Style="{StaticResource GlassTextBoxStyle}" />

                    <TextBlock Text="EPO OPS" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"
                               Text="Get keys: https://developers.epo.org → create an app → Consumer Key + Consumer Secret." />
                    <TextBox x:Name="EpoKeyBox" PlaceholderText="Consumer Key" Style="{StaticResource GlassTextBoxStyle}" />
                    <TextBox x:Name="EpoSecretBox" PlaceholderText="Consumer Secret" Style="{StaticResource GlassTextBoxStyle}" />

                    <TextBlock Text="WIPO" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"
                               Text="Get access: https://www.wipo.int/reference/en/ → APIs / contact WIPO for PATENTSCOPE or Global Brand Database." />
                    <TextBox x:Name="WipoKeyBox" PlaceholderText="API Key" Style="{StaticResource GlassTextBoxStyle}" />

                    <TextBlock Text="OCR provider" FontWeight="SemiBold" FontSize="13" Margin="0,8,0,0"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{ThemeResource TextTertiaryBrush}"
                               Text="Azure AI Vision (portal.azure.com), Google Cloud Vision, AWS Textract, or leave empty for local Tesseract later." />
                    <ComboBox x:Name="OcrProviderBox" HorizontalAlignment="Stretch"
                              SelectedIndex="0">
                        <x:String>None (local / Tesseract)</x:String>
                        <x:String>Azure AI Vision</x:String>
                        <x:String>Google Cloud Vision</x:String>
                        <x:String>AWS Textract</x:String>
                    </ComboBox>
                    <TextBox x:Name="OcrKeyBox" PlaceholderText="OCR API Key / Secret" Style="{StaticResource GlassTextBoxStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                        <Button Content="Save API keys" Style="{StaticResource LiquidButtonStyle}" Click="SaveApiKeys_Click" />
                        <Button Content="Clear keys" Style="{StaticResource GlassButtonStyle}" Click="ClearApiKeys_Click" />
                    </StackPanel>
                    <TextBlock x:Name="ApiKeysStatusText" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Audit -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="Audit trail" FontWeight="SemiBold" FontSize="16"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <Button Content="Verify chain integrity" Style="{StaticResource GlassButtonStyle}"
                            HorizontalAlignment="Left" Click="VerifyChain_Click" />
                    <TextBlock x:Name="ChainStatusText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>


            <!-- AI assistance. Three providers, asked the same question at once.
                 The value is not a better single answer - it is that agreement
                 between independent models is evidence, and disagreement is a
                 flag to open the document yourself. -->
            <Border Style="{StaticResource GlassSurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="AI assistance" FontWeight="SemiBold" FontSize="16"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="Add a key for any of Claude, Gemini or OpenAI. Every ticked provider is asked the same question at the same time: where they agree you have corroboration, where they disagree the answer is flagged for you to check. Keys are encrypted with Windows DPAPI under your account and stored in the app data folder — never in the database, and never in a log." />

                    <ToggleSwitch x:Name="AiEnabledSwitch" Header="Enable AI assistance"
                                  OnContent="On" OffContent="Off" Toggled="AiSetting_Changed" />

                    <!-- Consent is deliberately its own switch. Pasting a key is a
                         statement about billing; sending a client's examination
                         report to a third party is a statement about
                         confidentiality, and the second does not follow from the
                         first. Nothing is transmitted until this is on. -->
                    <ToggleSwitch x:Name="AiConsentSwitch" Header="I approve sending document text to these providers"
                                  OnContent="Approved" OffContent="Not approved" Toggled="AiSetting_Changed" />
                    <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource WarningBrush}"
                               Text="This sends the text of client documents to a third-party service. Check your firm's confidentiality obligations before turning it on. Testing a key does not send document text." />

                    <Border Style="{StaticResource GlassSeparatorStyle}" />

                    <!-- Anthropic -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox x:Name="AnthropicActive" Content="Claude (Anthropic)" MinWidth="200"
                                      Checked="AiSetting_Changed" Unchecked="AiSetting_Changed" />
                            <TextBlock x:Name="AnthropicStatus" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PasswordBox x:Name="AnthropicKeyBox" Width="330" PlaceholderText="sk-ant-..." />
                            <TextBox x:Name="AnthropicModelBox" Width="190" PlaceholderText="model" />
                            <Button Content="Save" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Tag="Anthropic" Click="AiSaveKey_Click" />
                            <Button Content="Test" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Tag="Anthropic" Click="AiTestKey_Click" />
                            <Button Content="Clear" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Tag="Anthropic" Click="AiClearKey_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Gemini -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox x:Name="GeminiActive" Content="Gemini (Google)" MinWidth="200"
                                      Checked="AiSetting_Changed" Unchecked="AiSetting_Changed" />
                            <TextBlock x:Name="GeminiStatus" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PasswordBox x:Name="GeminiKeyBox" Width="330" PlaceholderText="AIza..." />
                            <TextBox x:Name="GeminiModelBox" Width="190" PlaceholderText="model" />
                            <Button Content="Save" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Tag="Gemini" Click="AiSaveKey_Click" />
                            <Button Content="Test" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Tag="Gemini" Click="AiTestKey_Click" />
                            <Button Content="Clear" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Tag="Gemini" Click="AiClearKey_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- OpenAI -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox x:Name="OpenAiActive" Content="OpenAI" MinWidth="200"
                                      Checked="AiSetting_Changed" Unchecked="AiSetting_Changed" />
                            <TextBlock x:Name="OpenAiStatus" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <PasswordBox x:Name="OpenAiKeyBox" Width="330" PlaceholderText="sk-..." />
                            <TextBox x:Name="OpenAiModelBox" Width="190" PlaceholderText="model" />
                            <Button Content="Save" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Tag="OpenAi" Click="AiSaveKey_Click" />
                            <Button Content="Test" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Tag="OpenAi" Click="AiTestKey_Click" />
                            <Button Content="Clear" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Tag="OpenAi" Click="AiClearKey_Click" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource GlassSeparatorStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBox x:Name="AiTimeoutBox" Width="120" Header="Timeout (seconds)"
                                 Style="{StaticResource GlassTextBoxStyle}" />
                        <Button Content="Open key folder" VerticalAlignment="Bottom"
                                Style="{StaticResource MergedGlassButtonBaseStyle}"
                                Click="OpenAiFolder_Click" />
                    </StackPanel>

                    <TextBlock x:Name="AiStatusText" TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Material -->
            <Border Style="{StaticResource GlassCardStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="Material and accessibility" FontWeight="SemiBold" FontSize="16"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="Desktop Acrylic is preferred for liquid-glass blur of the desktop. Mica Alt is used when Acrylic is unavailable. The system may switch to a solid color under battery saver, transparency-off, or high-contrast policy." />
                </StackPanel>
            </Border>

            <TextBlock Text="Developed by Anant Goel · IP Docketing"
                       FontSize="12" Margin="4,8,0,0"
                       Foreground="{ThemeResource TextTertiaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
