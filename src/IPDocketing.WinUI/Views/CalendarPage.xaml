<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.CalendarPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent"
    Loaded="Page_Loaded">

    <Grid Padding="30,24,30,30" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Calendar" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="See operative dates, overdue work and upcoming filing priorities."
                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Today" Style="{StaticResource GlassButtonStyle}"
                    VerticalAlignment="Center" Click="Today_Click" />
            <Button Grid.Column="2" Content="Show overdue" Style="{StaticResource GlassButtonStyle}"
                    VerticalAlignment="Center" Click="ShowOverdue_Click" />
            <Button Grid.Column="3" Content="Refresh" Style="{StaticResource LiquidButtonStyle}"
                    VerticalAlignment="Center" Click="Refresh_Click" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource GlassCardStyle}" Padding="18,14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Overdue" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="OverdueCountText" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="18,14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Next 7 days" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="UpcomingCountText" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="18,14">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Completed" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CompletedCountText" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource GlassCardStyle}" Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Overdue" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Upcoming" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Pending" FontSize="11" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <CalendarView x:Name="DeadlineCalendar"
                                  Grid.Row="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  SelectionMode="Single"
                                  NumberOfWeeksInView="6"
                                  FirstDayOfWeek="Monday"
                                  DayItemMargin="3"
                                  CalendarItemCornerRadius="12"
                                  CalendarItemBackground="{ThemeResource GlassInputBrush}"
                                  CalendarItemBorderBrush="{ThemeResource GlassHairlineBrush}"
                                  CalendarItemBorderThickness="1"
                                  TodayBackground="{ThemeResource GlassSurfaceHoverBrush}"
                                  TodayForeground="{ThemeResource TextPrimaryBrush}"
                                  SelectedBorderBrush="{StaticResource AccentBrush}"
                                  SelectedForeground="{ThemeResource TextPrimaryBrush}"
                                  SelectedDatesChanged="DeadlineCalendar_SelectedDatesChanged"
                                  CalendarViewDayItemChanging="DeadlineCalendar_DayItemChanging" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource GlassCardStyle}" Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SelectedDateText" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="SelectedDateSummary" Grid.Row="1"
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <ListView x:Name="SelectedDeadlineList" Grid.Row="2"
                              Background="Transparent" SelectionMode="Single"
                              SelectionChanged="SelectedDeadlineList_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,10" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="9" Height="9" Fill="{Binding UrgencyBrush}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                   TextWrapping="Wrap" Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Matter}" FontSize="11"
                                                   Foreground="{ThemeResource TextSecondaryBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DueDate}" HorizontalAlignment="Right"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Urgency}" FontSize="11" HorizontalAlignment="Right"
                                                   Foreground="{Binding UrgencyBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Button x:Name="MarkCompleteButton" Grid.Row="3"
                            Content="Mark selected complete"
                            Style="{StaticResource LiquidButtonStyle}"
                            HorizontalAlignment="Right" IsEnabled="False"
                            Click="MarkComplete_Click" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
