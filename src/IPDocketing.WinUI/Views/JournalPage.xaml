<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.JournalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid>

    <Grid Padding="30,24,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Journal Watch" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Weekly TMR Journal issues — track which ones you've reviewed for conflicting marks."
                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <!-- Six buttons in a non-wrapping horizontal StackPanel overflowed
                 the window and pushed the newest ones off-screen entirely -
                 which looks identical to "the feature was never added".
                 Consolidated into one primary action plus a menu, so the
                 toolbar can no longer outgrow the window. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Get journal PDFs" Style="{StaticResource MergedAccentButtonStyle}"
                        Click="AutoDownload_Click"
                        ToolTipService.ToolTip="Drives a hidden browser: clicks each class-range link and saves the PDF. Nothing is shown - you just get a result log." />

                <DropDownButton Content="Journal tools" Style="{StaticResource MergedGlassButtonBaseStyle}">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Browse and pick files..." Click="BrowseIssues_Click" />
                            <MenuFlyoutItem Text="Pull latest weekly issues" Click="PullLatest_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Find a name in the Journal..." Click="FindName_Click" />
                            <MenuFlyoutItem Text="Watch report..." Click="WatchReport_Click" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Log an issue manually..." Click="AddIssue_Click" />
                            <MenuFlyoutItem Text="Self-test: what can this page reach?" Click="SelfTest_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <!-- Real automatic fetch: this specific IP India page has no login/CAPTCHA,
             so this genuinely fetches live from ipindia.gov.in - not a manual-paste
             workaround like the Watch alerts below still are. -->
        <Border Grid.Row="1" Style="{StaticResource GlassSurfaceCompactStyle}" Padding="16" Margin="0,0,0,16">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Auto-fetch:" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <DatePicker x:Name="FetchDateBox" Grid.Column="1" />
                <TextBlock Grid.Column="2" Text="Class" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBox x:Name="FetchClassBox" Grid.Column="3" PlaceholderText="e.g. 25" />
                <Button Grid.Column="4" Content="Fetch from IP India" Style="{StaticResource MergedAccentButtonStyle}"
                        Click="AutoFetch_Click" Margin="10,0,0,0" />
                <TextBlock x:Name="FetchStatusText" Grid.Column="5" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassSurfaceStyle}" Padding="8" Margin="0,0,0,16">
            <ListView x:Name="IssueList" Background="Transparent" SelectionMode="Single" MaxHeight="220">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,13" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding IssueNumber}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PublicationDate}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />

                            <!-- Was a HyperlinkButton bound straight to Url. Most
                                 issues have no URL at all (the listing uses
                                 postbacks), and NavigateUri does not accept an
                                 empty string - so that binding was a latent
                                 throw on exactly the rows you have. Plain text
                                 plus an explicit Open button, enabled only when
                                 there is something to open. -->
                            <TextBlock Grid.Column="2" Text="{Binding LinkLabel}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" FontSize="12"
                                       Foreground="{ThemeResource TextTertiaryBrush}" />

                            <Button Grid.Column="3" Content="Open" FontSize="11"
                                    Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding HasUrl}"
                                    Click="RowOpenUrl_Click" Tag="{Binding Id}"
                                    ToolTipService.ToolTip="Open the journal PDF in your browser" />

                            <Button Grid.Column="4" Content="Get PDF" FontSize="11"
                                    Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="RowGetPdf_Click" Tag="{Binding Id}"
                                    ToolTipService.ToolTip="Fetch this issue's PDFs through the hidden browser" />

                            <!-- The badge is now the pipeline's real state and is
                                 clickable: it opens what the status means and the
                                 error behind it, and offers the reviewed toggle
                                 that used to be its only function. -->
                            <Button Grid.Column="5" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Click="IssueStatus_Click" Tag="{Binding Id}"
                                    ToolTipService.ToolTip="{Binding StatusDetail}">
                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding StatusBrush}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Watch alerts — marks flagged as similar to your portfolio"
                       Style="{StaticResource SubtitleStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Run watch on selected issue" Style="{StaticResource MergedGlassButtonBaseStyle}"
                    Click="RunWatch_Click" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource GlassSurfaceStyle}" Padding="8">
            <ListView x:Name="AlertList" Background="Transparent" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,13" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PublishedMark}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding PublishedApplicant}" FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MatterTitle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <!-- Why the alert fired. A bare percentage is
                                     something a reviewer can neither check nor
                                     trust, and unexplained alerts are the ones
                                     people stop reading. -->
                                <TextBlock Text="{Binding Explanation}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                <Border Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ScoreLabel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding ScoreBrush}" />
                                </Border>
                                <Border Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Left"
                                        Visibility="{Binding OcrVisibility}">
                                    <TextBlock Text="OCR — verify" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Dismiss" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Click="DismissAlert_Click" Tag="{Binding Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>

        <!-- LAST child of the root Grid, deliberately.
             In visible ("show the browser") mode the WebView2 was being drawn
             BEHIND the page, because this host was declared first and XAML
             paints children in declaration order. Being last makes it topmost
             when it is on screen, and costs nothing when it is parked off
             screen. Canvas.ZIndex is set as well, since a composited WebView2
             does not always respect declaration order on its own.

             It is parked outside the window rather than hidden with Opacity:
             WebView2 composites in its own layer and ignores both Opacity and
             ZIndex for that purpose, which is why the IP India page used to
             paint straight over this one. Position it does respect. It still
             needs a real layout size to initialise, so it keeps 900x700. -->
        <Grid x:Name="HiddenBrowserHost" Width="900" Height="700"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              IsHitTestVisible="False" Canvas.ZIndex="99"
              Margin="-4000,-4000,0,0" />
    </Grid>
</Page>
