<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.JournalPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="30,24,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Journal Watch" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Weekly TMR Journal issues — track which ones you've reviewed for conflicting marks."
                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Pull latest weekly issues" Style="{StaticResource MergedGlassButtonBaseStyle}"
                        Click="PullLatest_Click"
                        ToolTipService.ToolTip="Reads the public journal listing and logs the most recent issues with their PDF links" />
                <Button Content="Find a name" Style="{StaticResource MergedGlassButtonBaseStyle}"
                        Click="FindName_Click"
                        ToolTipService.ToolTip="Search downloaded Journal PDFs for a proprietor or agent name and report the page it appears on" />
                <Button Content="Watch report" Style="{StaticResource MergedGlassButtonBaseStyle}"
                        Click="WatchReport_Click"
                        ToolTipService.ToolTip="Builds the weekly watch report and opens it ready to print" />
                <Button Content="+ Log manually" Style="{StaticResource MergedGlassButtonBaseStyle}"
                        Click="AddIssue_Click" />
            </StackPanel>
        </Grid>

        <!-- Real automatic fetch: this specific IP India page has no login/CAPTCHA,
             so this genuinely fetches live from ipindia.gov.in - not a manual-paste
             workaround like the Watch alerts below still are. -->
        <Border Grid.Row="1" Style="{StaticResource GlassSurfaceCompactStyle}" Padding="16" Margin="0,0,0,16">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Auto-fetch:" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <DatePicker x:Name="FetchDateBox" Grid.Column="1" />
                <TextBlock Grid.Column="2" Text="Class" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="{ThemeResource TextSecondaryBrush}" />
                <TextBox x:Name="FetchClassBox" Grid.Column="3" PlaceholderText="e.g. 25" />
                <Button Grid.Column="4" Content="Fetch from IP India" Style="{StaticResource MergedAccentButtonStyle}"
                        Click="AutoFetch_Click" Margin="10,0,0,0" />
                <TextBlock x:Name="FetchStatusText" Grid.Column="5" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassSurfaceStyle}" Padding="8" Margin="0,0,0,16">
            <ListView x:Name="IssueList" Background="Transparent" SelectionMode="Single" MaxHeight="220">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,13" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding IssueNumber}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding PublicationDate}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <HyperlinkButton Grid.Column="2" Content="{Binding Url}" NavigateUri="{Binding Url}"
                                             VerticalAlignment="Center" />
                            <!-- Actionable now. JournalService.MarkReviewed existed
                                 but nothing called it, so every issue sat on
                                 "Pending review" forever with no way to clear it. -->
                            <Button Grid.Column="3" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Click="ToggleReviewed_Click" Tag="{Binding Id}"
                                    ToolTipService.ToolTip="Toggle between reviewed and pending">
                                <TextBlock Text="{Binding ReviewedLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding ReviewedBrush}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <Grid Grid.Row="3" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Watch alerts — marks flagged as similar to your portfolio"
                       Style="{StaticResource SubtitleStyle}" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Run watch on selected issue" Style="{StaticResource MergedGlassButtonBaseStyle}"
                    Click="RunWatch_Click" />
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource GlassSurfaceStyle}" Padding="8">
            <ListView x:Name="AlertList" Background="Transparent" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,13" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding PublishedMark}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding PublishedApplicant}" FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MatterTitle}"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <!-- Why the alert fired. A bare percentage is
                                     something a reviewer can neither check nor
                                     trust, and unexplained alerts are the ones
                                     people stop reading. -->
                                <TextBlock Text="{Binding Explanation}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                <Border Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ScoreLabel}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding ScoreBrush}" />
                                </Border>
                                <Border Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Left"
                                        Visibility="{Binding OcrVisibility}">
                                    <TextBlock Text="OCR — verify" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Dismiss" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                    Click="DismissAlert_Click" Tag="{Binding Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
