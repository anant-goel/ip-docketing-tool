<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.MattersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="30,24,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Matters" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Patents, trademarks and connected portfolio families."
                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Style="{StaticResource PillBadgeStyle}" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Border>
                <Button Content="+ Add matter" Style="{StaticResource MergedAccentButtonStyle}" Click="AddMatter_Click" />
                <Button Content="Import" Style="{StaticResource MergedGlassButtonBaseStyle}" Click="Import_Click"
                        ToolTipService.ToolTip="Bring a portfolio in from a CSV, with a preview before anything is written" />
                <Button Content="Export" Style="{StaticResource MergedGlassButtonBaseStyle}" Click="Export_Click"
                        ToolTipService.ToolTip="Write the whole portfolio out as CSV — the same columns the importer reads" />
            </StackPanel>
        </Grid>

        <!-- Comprehensive search (docx section 6): mark name plus proprietor / attorney / state,
             each field searched independently so you don't need a combined query syntax. -->
        <Grid Grid.Row="1" Margin="0,0,0,14" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="MarkSearchBox" Grid.Column="0" PlaceholderText="Search mark / title..." />
            <TextBox x:Name="ProprietorSearchBox" Grid.Column="1" PlaceholderText="Proprietor" />
            <TextBox x:Name="AttorneySearchBox" Grid.Column="2" PlaceholderText="Attorney" />
            <TextBox x:Name="StateSearchBox" Grid.Column="3" PlaceholderText="State" />
            <Button Grid.Column="4" Content="Search" Style="{StaticResource MergedGlassButtonBaseStyle}" Click="Search_Click" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource GlassSurfaceStyle}" Padding="8">
            <ListView x:Name="MatterList" Background="Transparent" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,13" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" CornerRadius="12"
                                    Background="{ThemeResource GlassInputBrush}"
                                    BorderBrush="{StaticResource LiquidEdgeBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE7C3;" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Number}" FontWeight="SemiBold"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding TypeAndApplicationNumber}" FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Client}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Proprietor}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding State}" FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Country}" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding FilingDate}" FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="5" Style="{StaticResource PillBadgeStyle}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Grid.Column="6" Text="{Binding AssignedTo}" VerticalAlignment="Center"
                                       FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="Status" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                        Click="TraceMatter_Click" Tag="{Binding Id}"
                                        ToolTipService.ToolTip="Open the full prosecution and opposition history" />
                                <Button Content="Assign" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                        Click="AssignMatter_Click" Tag="{Binding Id}" />
                                <Button Content="Log event" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                        Click="LogEvent_Click" Tag="{Binding Id}" />
                                <Button Content="Edit" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                        Click="EditMatter_Click" Tag="{Binding Id}" />
                                <Button Content="Delete" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                        Click="DeleteMatter_Click" Tag="{Binding Id}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
