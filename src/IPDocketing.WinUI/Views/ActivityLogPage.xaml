<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.ActivityLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="30,24,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Activity Log" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Every create, edit, delete and assignment across the docket, in an append-only, tamper-evident ledger."
                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border x:Name="IntegrityBadge" Style="{StaticResource PillBadgeStyle}" VerticalAlignment="Center">
                    <TextBlock x:Name="IntegrityText" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" />
                </Border>
                <Button Content="Refresh" Style="{StaticResource GlassButtonStyle}" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <TextBox x:Name="FilterBox" Grid.Row="1" PlaceholderText="Filter by entity type, action, or details..."
                 Margin="0,0,0,14" TextChanged="FilterBox_TextChanged" />

        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="8">
            <ListView x:Name="LogList" Background="Transparent" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,11" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="{Binding ActionBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Timestamp}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondaryBrush}" FontSize="12" />
                            <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActionType}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding ActionBrush}" />
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding EntityLabel}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextPrimaryBrush}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="4" Text="{Binding Details}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
