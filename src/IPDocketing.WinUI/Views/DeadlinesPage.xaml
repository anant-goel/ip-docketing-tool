<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.DeadlinesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="30,24,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Deadlines" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Operative dates, urgency and responsible owners."
                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource PillBadgeStyle}" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" Foreground="{ThemeResource TextSecondaryBrush}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="8">
            <ListView x:Name="DeadlineList" Background="Transparent" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,13" ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="{Binding UrgencyBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Matter}" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DueDate}" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding NominalDate}" FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Owner}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <Border Grid.Column="4" Style="{StaticResource PillBadgeStyle}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Urgency}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding UrgencyBrush}" />
                            </Border>
                            <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="Complete" Style="{StaticResource GlassButtonStyle}"
                                        Padding="10,5" Click="Complete_Click" Tag="{Binding Id}" />
                                <Button Content="Delete" Style="{StaticResource GlassButtonStyle}"
                                        Padding="10,5" Click="Delete_Click" Tag="{Binding Id}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
