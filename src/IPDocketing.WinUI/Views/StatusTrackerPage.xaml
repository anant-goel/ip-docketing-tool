<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.StatusTrackerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <!-- docx section 5: complete prosecution and opposition history for a mark,
         with a tool to print the status and its documents. -->
    <Grid Padding="30,24,30,30" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Status Tracker" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Full prosecution and opposition history for one mark, with everything on file against it."
                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="PrintButton" Content="Print status sheet"
                        Style="{StaticResource MergedAccentButtonStyle}"
                        IsEnabled="False" Click="Print_Click"
                        ToolTipService.ToolTip="Opens a printable status sheet in your browser and starts the print dialog" />
                <Button x:Name="CopyButton" Content="Copy as text"
                        Style="{StaticResource MergedGlassButtonBaseStyle}"
                        IsEnabled="False" Click="Copy_Click" />
                <Button Content="Refresh" Style="{StaticResource MergedGlassButtonBaseStyle}" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassSurfaceCompactStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Mark" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <ComboBox x:Name="MatterPicker" Grid.Column="1" HorizontalAlignment="Stretch"
                          PlaceholderText="Select a matter to trace"
                          SelectionChanged="MatterPicker_SelectionChanged" />
                <CheckBox x:Name="TrademarksOnlyToggle" Grid.Column="2" Content="Trademarks only"
                          IsChecked="True" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassSurfaceStyle}" Padding="4">
            <Grid>
                <ScrollViewer x:Name="DossierScroll" Padding="18" Visibility="Collapsed">
                    <StackPanel Spacing="18">

                        <!-- Current status -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="CURRENT STATUS" Style="{StaticResource GlassEyebrowStyle}" />
                            <TextBlock x:Name="MarkTitleText" Style="{StaticResource SectionTitleStyle}" FontSize="22" />
                            <StackPanel x:Name="StatusBadgeRow" Orientation="Horizontal" Spacing="8">
                                <Border Style="{StaticResource PillBadgeStyle}">
                                    <TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <Border x:Name="AlertBadge" Style="{StaticResource PillBadgeStyle}" Visibility="Collapsed">
                                    <TextBlock x:Name="AlertBadgeText" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource DangerBrush}" />
                                </Border>
                                <Border x:Name="OppositionBadge" Style="{StaticResource PillBadgeStyle}" Visibility="Collapsed">
                                    <TextBlock Text="Opposition open" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource WarningBrush}" />
                                </Border>
                            </StackPanel>
                            <ItemsControl x:Name="FactList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,4" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="190" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="12"
                                                       Foreground="{ThemeResource TextTertiaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Style="{StaticResource GlassSeparatorStyle}" />

                        <!-- Prosecution history -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="PROSECUTION HISTORY" Style="{StaticResource GlassEyebrowStyle}" />
                            <TextBlock x:Name="EventsEmptyText" Text="No events logged against this matter yet."
                                       FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"
                                       Visibility="Collapsed" />
                            <ItemsControl x:Name="EventList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Date}" FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Type}" FontWeight="SemiBold"
                                                       FontSize="13" Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Notes}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Style="{StaticResource GlassSeparatorStyle}" />

                        <!-- Deadlines -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="DEADLINES" Style="{StaticResource GlassEyebrowStyle}" />
                            <TextBlock x:Name="DeadlinesEmptyText" Text="No deadlines recorded."
                                       FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"
                                       Visibility="Collapsed" />
                            <ItemsControl x:Name="DeadlineList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="9" Height="9" Fill="{Binding UrgencyBrush}" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding RuleLabel}" FontSize="11"
                                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding DueDate}" FontSize="12"
                                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding NominalDate}" FontSize="11"
                                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding UrgencyBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Style="{StaticResource GlassSeparatorStyle}" />

                        <!-- Opposition status -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="OPPOSITION STATUS" Style="{StaticResource GlassEyebrowStyle}" />
                            <TextBlock x:Name="OppositionsEmptyText" Text="No opposition proceedings on record for this mark."
                                       FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"
                                       Visibility="Collapsed" />
                            <ItemsControl x:Name="OppositionList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,6" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" FontSize="13"
                                                           TextWrapping="Wrap"
                                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding OpposingParty}" FontSize="11"
                                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Direction}" FontSize="12"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Dates}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}"
                                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <Border Style="{StaticResource GlassSeparatorStyle}" />

                        <!-- Documents -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DOCUMENTS ON FILE" Style="{StaticResource GlassEyebrowStyle}" />
                                <Button Grid.Column="1" x:Name="OpenDocumentButton" Content="Open selected"
                                        Style="{StaticResource MergedGlassMiniButtonStyle}"
                                        IsEnabled="False" Click="OpenDocument_Click" />
                            </Grid>
                            <TextBlock x:Name="DocumentsEmptyText" Text="No documents filed against this mark."
                                       FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}"
                                       Visibility="Collapsed" />
                            <ListView x:Name="DocumentList" Background="Transparent" SelectionMode="Single"
                                      SelectionChanged="DocumentList_SelectionChanged" MaxHeight="300">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="4,8" ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Uploaded}" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{ThemeResource TextSecondaryBrush}" />
                                            <TextBlock Grid.Column="3" Text="{Binding VersionLabel}" VerticalAlignment="Center"
                                                       FontSize="12" Foreground="{ThemeResource TextTertiaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>

                        <TextBlock x:Name="FooterNoteText" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextTertiaryBrush}"
                                   Text="This sheet reflects what has been recorded locally. It is not a live read of the TMR portal - use the IP India Portal page to check the register itself." />
                    </StackPanel>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="64" Height="64" CornerRadius="24"
                            Background="{ThemeResource GlassInputBrush}"
                            BorderBrush="{StaticResource IridescentRimBrush}" BorderThickness="1">
                        <FontIcon Glyph="&#xE9D5;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="Select a mark above" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="Its full status, deadlines, oppositions and documents appear here."
                               HorizontalAlignment="Center" Foreground="{ThemeResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
