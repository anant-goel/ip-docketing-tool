<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.RenewalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="30,24,30,30" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Renewals" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" TextWrapping="Wrap"
                           Text="Ten years from the date of application, renewable indefinitely (s.25). The renewal window opens a year before expiry; a surcharge buys six months after it; restoration closes at twelve." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Content="Re-docket renewals" Style="{StaticResource MergedGlassButtonBaseStyle}"
                        Click="Redocket_Click"
                        ToolTipService.ToolTip="Recomputes the four statutory dates for every registered mark. Safe to run repeatedly." />
                <Button Content="Export watchlist" Style="{StaticResource MergedGlassButtonBaseStyle}" Click="Export_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassSurfaceCompactStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Horizon" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{ThemeResource TextPrimaryBrush}" />
                <ComboBox x:Name="HorizonBox" Grid.Column="1" MinWidth="180" SelectedIndex="2"
                          SelectionChanged="Filter_Changed">
                    <ComboBoxItem Content="Next 90 days" Tag="90" />
                    <ComboBoxItem Content="Next 180 days" Tag="180" />
                    <ComboBoxItem Content="Next 400 days" Tag="400" />
                    <ComboBoxItem Content="Everything, including lapsed" Tag="99999" />
                </ComboBox>
                <ComboBox x:Name="AttorneyBox" Grid.Column="2" MinWidth="220"
                          PlaceholderText="Any attorney" SelectionChanged="Filter_Changed" />
                <TextBlock x:Name="SummaryText" Grid.Column="3" VerticalAlignment="Center" FontSize="12"
                           TextWrapping="Wrap" Foreground="{ThemeResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource GlassSurfaceStyle}" Padding="6">
            <Grid>
                <ListView x:Name="RenewalList" Background="Transparent" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="12,11" ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="9" Height="9" Fill="{Binding StageBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                               Foreground="{ThemeResource TextTertiaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ExpiryLabel}" FontSize="12"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding CountdownLabel}" FontSize="11"
                                               Foreground="{Binding StageBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Attorney}" VerticalAlignment="Center"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Border Grid.Column="4" Style="{StaticResource PillBadgeStyle}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Stage}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{Binding StageBrush}" />
                                </Border>
                                <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Content="Mark renewed" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                            Click="MarkRenewed_Click" Tag="{Binding MatterId}" />
                                    <Button Content="Status" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                            Click="OpenStatus_Click" Tag="{Binding MatterId}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <Border Width="64" Height="64" CornerRadius="24"
                            Background="{ThemeResource GlassInputBrush}"
                            BorderBrush="{StaticResource IridescentRimBrush}" BorderThickness="1">
                        <FontIcon Glyph="&#xE823;" FontSize="24" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock x:Name="EmptyTitleText" Text="Nothing due in this window" FontSize="18"
                               FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock x:Name="EmptyBodyText" HorizontalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="480" TextAlignment="Center"
                               Foreground="{ThemeResource TextSecondaryBrush}"
                               Text="A renewal term needs a filing date on the matter. Marks with no filing or registration date can't be scheduled — add one on the Matters page." />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
