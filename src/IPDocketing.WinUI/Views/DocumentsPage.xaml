<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="30,24,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Documents" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Matter files, versions and OCR processing state."
                       Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="8">
            <ListView x:Name="DocumentList" Background="Transparent" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,13" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="130" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="12"
                                    Background="{ThemeResource GlassInputBrush}"
                                    BorderBrush="{StaticResource LiquidEdgeBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE8A5;" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Matter}" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Type}" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Uploaded}" FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OcrStatus}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding OcrBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
