<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.DocumentsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="30,24,30,30" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Documents" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Add matter files, review versions and monitor OCR processing."
                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Add files" Style="{StaticResource LiquidButtonStyle}"
                    VerticalAlignment="Center" Click="AddFiles_Click" />
            <Button x:Name="OpenFileButton" Grid.Column="2" Content="Open file"
                    Style="{StaticResource GlassButtonStyle}" VerticalAlignment="Center"
                    IsEnabled="False" Click="OpenFile_Click" />
            <Button Grid.Column="3" Content="Refresh" Style="{StaticResource GlassButtonStyle}"
                    VerticalAlignment="Center" Click="Refresh_Click" />
        </Grid>

        <InfoBar x:Name="DocumentInfoBar" Grid.Row="1" IsOpen="False" IsClosable="True" />

        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="8">
            <Grid>
                <ListView x:Name="DocumentList" Background="Transparent" SelectionMode="Single"
                          SelectionChanged="DocumentList_SelectionChanged">
                    <ListView.Transitions>
                        <TransitionCollection>
                            <EntranceThemeTransition FromVerticalOffset="18" />
                        </TransitionCollection>
                    </ListView.Transitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,13" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="38" Height="38" CornerRadius="12"
                                    Background="{ThemeResource GlassInputBrush}"
                                    BorderBrush="{StaticResource LiquidEdgeBrush}" BorderThickness="1">
                                <FontIcon Glyph="&#xE8A5;" FontSize="15" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Matter}" FontSize="12"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Type}" Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Uploaded}" FontSize="11"
                                           Foreground="{ThemeResource TextTertiaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OcrStatus}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{Binding OcrBrush}" />
                            </Border>
                            <Button Grid.Column="4" Content="Delete" Style="{StaticResource GlassButtonStyle}"
                                    Padding="10,5" VerticalAlignment="Center" Click="DeleteDocument_Click" Tag="{Binding Id}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10">
                    <Border Width="64" Height="64" CornerRadius="24"
                            Background="{ThemeResource GlassInputBrush}"
                            BorderBrush="{StaticResource LiquidEdgeBrush}" BorderThickness="1">
                        <FontIcon Glyph="&#xE8A5;" FontSize="25" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Text="No documents added yet" FontSize="18" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Foreground="{ThemeResource TextPrimaryBrush}" />
                    <TextBlock Text="Add PDF, Word or image files to a matter."
                               Foreground="{ThemeResource TextSecondaryBrush}" />
                    <Button Content="Add files" Style="{StaticResource LiquidButtonStyle}"
                            HorizontalAlignment="Center" Click="AddFiles_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
