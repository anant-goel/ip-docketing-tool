<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.OppositionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">

    <Grid Padding="30,24,30,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Oppositions" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="Filed by us and filed against our marks, in one register."
                           Style="{StaticResource SubtitleStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Style="{StaticResource PillBadgeStyle}" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Foreground="{ThemeResource TextSecondaryBrush}" />
                </Border>
                <Button Content="+ New opposition" Style="{StaticResource LiquidButtonStyle}" Click="AddOpposition_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Padding="8">
            <ListView x:Name="OppositionList" Background="Transparent" SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,13" ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TrademarkNumber}" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding MarkDetails}" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding OpposingParty}" FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Direction}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Grid.Column="4" Text="{Binding HearingDate}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="5" Text="{Binding AssignedTo}" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextSecondaryBrush}" />
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Button Content="Edit" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5" Click="EditOpposition_Click" Tag="{Binding Id}" />
                                <Button Content="Delete" Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,5" Click="DeleteOpposition_Click" Tag="{Binding Id}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
