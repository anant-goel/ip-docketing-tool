<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="IPDocketing.WinUI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:IPDocketing.WinUI.Views"
    Background="Transparent">

    <ScrollViewer Padding="30,24,30,30"
                  HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
        <Grid RowSpacing="8" MaxWidth="1480" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Content="+ Add matter" Style="{StaticResource MergedAccentButtonStyle}" Click="AddMatter_Click" />
                    <Button Content="Notify team" Style="{StaticResource MergedGlassButtonBaseStyle}" Click="NotifyTeam_Click"
                            ToolTipService.ToolTip="Build a per-person digest of approaching and overdue deadlines" />
                    <Button Content="Assign to team member" Style="{StaticResource MergedGlassButtonBaseStyle}" Click="AssignTeamMember_Click" />
                </StackPanel>
            </Grid>
            <TextBlock Text="Portfolio health and the deadlines that need attention next."
                       Grid.Row="1" Style="{StaticResource SubtitleStyle}" />

            <Grid Grid.Row="2" ColumnSpacing="14" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource GlassSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="OVERDUE" Foreground="{ThemeResource TextSecondaryBrush}"
                                       FontSize="11" CharacterSpacing="80" />
                        </StackPanel>
                        <TextBlock x:Name="OverdueText" Text="0" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="NEXT 14 DAYS" Foreground="{ThemeResource TextSecondaryBrush}"
                                       FontSize="11" CharacterSpacing="80" />
                        </StackPanel>
                        <TextBlock x:Name="UpcomingText" Text="0" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="PTO RESPONSE" Foreground="{ThemeResource TextSecondaryBrush}"
                                       FontSize="11" CharacterSpacing="80" />
                        </StackPanel>
                        <TextBlock x:Name="PendingText" Text="0" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{StaticResource InfoBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="3" Style="{StaticResource GlassSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="COMPLETED" Foreground="{ThemeResource TextSecondaryBrush}"
                                       FontSize="11" CharacterSpacing="80" />
                        </StackPanel>
                        <TextBlock x:Name="CompletedText" Text="0" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Notifications strip (docx section 1): the things a docketing clerk
                 would otherwise have to remember to go check on their own. -->
            <Grid Grid.Row="3" ColumnSpacing="14" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource GlassSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="OPEN OPPOSITIONS" Foreground="{ThemeResource TextSecondaryBrush}"
                                       FontSize="11" CharacterSpacing="80" />
                        </StackPanel>
                        <TextBlock x:Name="OppositionsText" Text="0" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource GlassSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="WATCH ALERTS" Foreground="{ThemeResource TextSecondaryBrush}"
                                       FontSize="11" CharacterSpacing="80" />
                        </StackPanel>
                        <TextBlock x:Name="WatchAlertsText" Text="0" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource GlassSurfaceStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource InfoBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="UNASSIGNED MATTERS" Foreground="{ThemeResource TextSecondaryBrush}"
                                       FontSize="11" CharacterSpacing="80" />
                        </StackPanel>
                        <TextBlock x:Name="UnassignedText" Text="0" Style="{StaticResource MetricValueStyle}"
                                   Foreground="{StaticResource InfoBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- docx section 1: "automated tool which sends notification to
                 internal team members for approaching deadlines". Who owes what
                 is computed automatically; delivery needs a click, because no
                 mail transport is configured in this app. -->
            <Border Grid.Row="4" Style="{StaticResource GlassSurfaceCompactStyle}" Margin="0,0,0,14">
                <StackPanel Spacing="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="TEAM NOTIFICATIONS" Style="{StaticResource GlassEyebrowStyle}" />
                            <TextBlock x:Name="NotifySummaryText" FontSize="13"
                                       Foreground="{ThemeResource TextPrimaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                VerticalAlignment="Center" Click="NotifyTeam_Click" />
                    </Grid>
                    <ItemsControl x:Name="DigestList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0,6" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{ThemeResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding EmailLabel}" FontSize="11"
                                                   Foreground="{ThemeResource TextTertiaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Summary}" VerticalAlignment="Center"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Content="Copy" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                                Click="CopyDigest_Click" Tag="{Binding Key}" />
                                        <Button Content="Email" Style="{StaticResource MergedGlassMiniButtonStyle}"
                                                Click="EmailDigest_Click" Tag="{Binding Key}"
                                                IsEnabled="{Binding CanEmail}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="5" Text="Nearest deadlines" Style="{StaticResource SectionTitleStyle}" Margin="2,0,0,8" />
            <Border Grid.Row="6" Style="{StaticResource GlassSurfaceStyle}" Padding="8">
                <ListView x:Name="DeadlineList" SelectionMode="None" IsItemClickEnabled="False"
                          Background="Transparent">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,10" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="10" Height="10" Fill="{Binding UrgencyBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                               Foreground="{ThemeResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding MatterNumber}" FontSize="12"
                                               Foreground="{ThemeResource TextSecondaryBrush}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DueDateText}"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextSecondaryBrush}" />
                                <Border Grid.Column="3" Style="{StaticResource PillBadgeStyle}">
                                    <TextBlock Text="{Binding StatusLabel}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{Binding UrgencyBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
