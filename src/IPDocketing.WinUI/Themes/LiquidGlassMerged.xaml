<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        PHASE 30 - merged from the two Liquid Glass reference repositories that
        ship alongside this project under /third_party.

        What was actually taken, and what could not be:

        1. third_party/liquid-glass-web  (SVG/WebGL implementation)
           Its look is a backdrop-filter feeding an feDisplacementMap driven by
           a generated specular map. WinUI has no backdrop displacement filter,
           so the DISPLACEMENT is not reproducible - but every tuned constant
           behind that reference is, and those are what actually make it read as
           glass. Ported verbatim from its :root and control defaults:
             tint-color         #FFFFFF at 6%      -> GlassTintOverlayBrush
             shadow-color       #FFFFFF at 45%     -> bezel gradient stop 0
             shadow-blur/spread 20px / minus 5px       -> BezelInnerRim geometry
             outer-shadow-blur  24px, black 18%    -> LiquidCardShadowBrush
             glass-radius       60 on a 300x200 box (~20% of the short edge)
                                                    -> corner radii below
             bezel width         60, refractive index 3.0, blur 0.3
                                                    -> bezel band thickness/falloff
             specular opacity 0.5, saturation 4     -> SpecularSweepBrush
           The transition curve is its cubic-bezier(0.32, 0.72, 0, 1), expressed
           here as the equivalent KeySpline.

        2. third_party/wpf-liquid-glass  (WPF pixel-shader implementation)
           That one captures the screen behind the window and runs GlassyEffect.ps
           over the capture. It is a WPF ShaderEffect; WinUI 3 removed
           ShaderEffect entirely, and the screen-capture-per-move approach would
           be a poor trade on a docketing app that sits open all day. What ported
           cleanly is its layering order and its edge treatment:
             WindowFrameBorder      #18000000 substrate over system blur
             inner content wash     #4DFFFFFF
             two-stop diagonal rim  #80FFFFFF -> #40A6E1FF -> #40FFB3E1 -> #80FFFFFF
           reproduced as GlassSubstrateBrush, GlassContentWashBrush and
           IridescentRimBrush below. Its traffic-light caption buttons were left
           out on purpose: replacing the Windows caption controls hurts muscle
           memory and accessibility for no functional gain.

        Nothing here adds a NuGet dependency, a shader file or a composition
        controller. It is all brushes and templates, so it cannot fail to build
        on a GitHub Actions runner.

        Loaded AFTER Themes/LiquidGlass.xaml in App.xaml, so where a key name
        collides this file wins - that is intentional layering, not a duplicate.
    -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- web ref: rgba(255,255,255,0.06) -->
            <SolidColorBrush x:Key="GlassTintOverlayBrush" Color="#0FFFFFFF" />
            <!-- wpf ref: #18000000 substrate + #4DFFFFFF content wash -->
            <SolidColorBrush x:Key="GlassSubstrateBrush" Color="#18000000" />
            <SolidColorBrush x:Key="GlassContentWashBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="GlassDepthShadowBrush" Color="#2E000000" />
            <SolidColorBrush x:Key="GlassSeparatorBrush" Color="#1FFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GlassTintOverlayBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="GlassSubstrateBrush" Color="#0A000000" />
            <SolidColorBrush x:Key="GlassContentWashBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="GlassDepthShadowBrush" Color="#1A000000" />
            <SolidColorBrush x:Key="GlassSeparatorBrush" Color="#22000000" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <!-- Glass is suppressed wholesale under high contrast. Windows users
                 who turn it on need edges they can see, not translucency. -->
            <SolidColorBrush x:Key="GlassTintOverlayBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassSubstrateBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassContentWashBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassDepthShadowBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GlassSeparatorBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ==== Geometry ====================================================
         The web reference uses radius 60 on a 300x200 pane. Held to the same
         ~20-30% of the short edge here rather than copying the pixel value,
         which would be a pill on a 40px control. Rounded superellipse-ish
         squares throughout - never full pills on interactive surfaces. -->
    <CornerRadius x:Key="GlassRadiusLarge">26</CornerRadius>
    <CornerRadius x:Key="GlassRadiusMedium">18</CornerRadius>
    <CornerRadius x:Key="GlassRadiusSmall">13</CornerRadius>
    <Thickness x:Key="GlassBezelThickness">1.4</Thickness>

    <!-- ==== Edge and light ==============================================
         IridescentRimBrush is the WPF reference's four-stop diagonal rim.
         BezelInnerRimBrush stands in for its inset white shadow
         (blur 20, spread -5, white 45%) - a thin inner band that is bright at
         the top-left and cools toward the bottom-right, which is what sells the
         thickness of the glass. -->
    <LinearGradientBrush x:Key="IridescentRimBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#80FFFFFF" Offset="0" />
        <GradientStop Color="#40A6E1FF" Offset="0.35" />
        <GradientStop Color="#40FFB3E1" Offset="0.65" />
        <GradientStop Color="#80FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BezelInnerRimBrush" StartPoint="0.1,0" EndPoint="0.9,1">
        <GradientStop Color="#73FFFFFF" Offset="0" />
        <GradientStop Color="#1FFFFFFF" Offset="0.18" />
        <GradientStop Color="#00FFFFFF" Offset="0.55" />
        <GradientStop Color="#1AA6E1FF" Offset="0.86" />
        <GradientStop Color="#4DBBD6FF" Offset="1" />
    </LinearGradientBrush>

    <!-- Specular sweep: web reference's specular map at opacity 0.5,
         saturation 4, angle biased to the upper-left light source. -->
    <LinearGradientBrush x:Key="SpecularSweepBrush" StartPoint="0,0" EndPoint="0.85,1">
        <GradientStop Color="#66FFFFFF" Offset="0" />
        <GradientStop Color="#1FE8F3FF" Offset="0.22" />
        <GradientStop Color="#00FFFFFF" Offset="0.5" />
        <GradientStop Color="#14D6C4FF" Offset="0.84" />
        <GradientStop Color="#3DFFFFFF" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="CardGlareBrush" Center="0.28,-0.05" GradientOrigin="0.28,-0.05"
                         RadiusX="0.9" RadiusY="0.62">
        <GradientStop Color="#4DFFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="0.45" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <!-- ==== Motion ======================================================
         The web reference's cubic-bezier(0.32, 0.72, 0, 1) - a fast start that
         settles rather than easing symmetrically. Everything animated in this
         app should use this curve so motion feels like one material. -->
    <KeySpline x:Key="LiquidEase" ControlPoint1="0.32,0.72" ControlPoint2="0,1" />
    <x:Double x:Key="LiquidHoverScale">1.02</x:Double>
    <x:Double x:Key="LiquidPressScale">0.978</x:Double>

    <!-- ==== Surfaces ====================================================
         GlassSurfaceStyle is the merged card: acrylic substrate, tint overlay,
         inner bezel rim, specular sweep and a top glare, stacked in the order
         the WPF reference stacks its own layers. Applied to a Border with a
         single child, exactly like GlassCardStyle, so it is a drop-in upgrade
         anywhere GlassCardStyle is already used. -->
    <Style x:Key="GlassSurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource IridescentRimBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource GlassBezelThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassRadiusLarge}" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <!-- Compact variant for list rows and inline strips. -->
    <Style x:Key="GlassSurfaceCompactStyle" TargetType="Border" BasedOn="{StaticResource GlassSurfaceStyle}">
        <Setter Property="CornerRadius" Value="{StaticResource GlassRadiusMedium}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <!-- A hairline separator that reads correctly on translucent material,
         where the stock ListView separator disappears entirely. -->
    <Style x:Key="GlassSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource GlassSeparatorBrush}" />
        <Setter Property="Margin" Value="0,6" />
    </Style>

    <!-- Section label above a glass card. -->
    <Style x:Key="GlassEyebrowStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="90" />
        <Setter Property="Foreground" Value="{ThemeResource TextTertiaryBrush}" />
        <Setter Property="Margin" Value="2,0,0,6" />
    </Style>

    <!-- Read-only monospace block for generated report text. Cascadia Mono ships
         with Windows 11 and falls back to Consolas on 10, both present without
         shipping a font file. -->
    <Style x:Key="GlassReadoutStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource GlassInputBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassRadiusSmall}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <!-- ==== Refined glass button =========================================
         Same control contract as LiquidGlassButtonBaseStyle in LiquidGlass.xaml,
         rebuilt with the merged layer stack: substrate, tint, bezel rim,
         specular sweep, glare, then content. The hover/press scales and the
         transition duration come from the web reference. -->
    <Style x:Key="MergedGlassButtonBaseStyle" TargetType="Button">
        <Setter Property="BorderBrush" Value="{StaticResource IridescentRimBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource GlassRadiusSmall}" />
        <Setter Property="Padding" Value="17,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Background" Value="{ThemeResource GlassButtonBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.18" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Bloom.Opacity" Value="0.46" />
                                        <Setter Target="Specular.Opacity" Value="0.9" />
                                        <Setter Target="Glare.Opacity" Value="0.85" />
                                        <Setter Target="HoverWash.Opacity" Value="0.16" />
                                        <Setter Target="ButtonScale.ScaleX" Value="1.02" />
                                        <Setter Target="ButtonScale.ScaleY" Value="1.02" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Bloom.Opacity" Value="0.1" />
                                        <Setter Target="Specular.Opacity" Value="0.42" />
                                        <Setter Target="Glare.Opacity" Value="0.3" />
                                        <Setter Target="PressShade.Opacity" Value="0.18" />
                                        <Setter Target="ButtonScale.ScaleX" Value="0.978" />
                                        <Setter Target="ButtonScale.ScaleY" Value="0.978" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <!-- outer bloom - web ref outer shadow, blur 24 -->
                        <Border x:Name="Bloom" Margin="-3" Background="#2A76B8FF"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0.22" />
                        <!-- substrate -->
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!-- 6% white tint, straight from the web reference -->
                        <Border Margin="1" Background="{ThemeResource GlassTintOverlayBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <!-- inner bezel rim, standing in for the inset shadow -->
                        <Border Margin="1" Background="{StaticResource BezelInnerRimBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0.7" />
                        <Border x:Name="Specular" Margin="1" Background="{StaticResource SpecularSweepBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0.5" />
                        <Border x:Name="HoverWash" Margin="1" Background="#FFFFFFFF"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="PressShade" Margin="1" Background="#FF06101C"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" />
                        <Border x:Name="Glare" Height="13" Margin="6,3,6,0" VerticalAlignment="Top"
                                Background="{StaticResource CardGlareBrush}"
                                CornerRadius="999" Opacity="0.6" />

                        <ContentPresenter x:Name="ContentPresenter"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Foreground="{TemplateBinding Foreground}" />

                        <Border x:Name="FocusRing" Margin="-3"
                                BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False" Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MergedAccentButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MergedGlassButtonBaseStyle}">
        <Setter Property="Background" Value="{ThemeResource AccentGlassButtonBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Padding" Value="18,9" />
    </Style>

    <!-- Small, dense variant for in-row actions. -->
    <Style x:Key="MergedGlassMiniButtonStyle" TargetType="Button"
           BasedOn="{StaticResource MergedGlassButtonBaseStyle}">
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

</ResourceDictionary>
