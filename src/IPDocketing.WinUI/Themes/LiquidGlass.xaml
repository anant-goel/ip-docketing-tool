<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Blurred substrate, directional edge, crisp content, restrained liquid glare. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="SolidAppBackgroundBrush" Color="#FF080B12" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF7F8FA" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF9EA8BA" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF748094" />
            <!-- TRANSPARENCY RETUNE.
                 TintLuminosityOpacity is the property that decides whether a
                 surface reads as glass or as paint. At the old 0.82-0.90 the
                 luminosity layer is almost fully opaque, so every panel, card
                 and button was a flat matte slab with a blurred edge - the
                 backdrop behind it was doing nothing. Dropping it to roughly a
                 third lets the desktop and the colour field actually show
                 through, which is the whole point of the material.
                 TintOpacity comes down with it so the tint reads as a wash over
                 what is behind rather than a fill in its own right, and the
                 Fallback alphas follow so machines with transparency disabled
                 degrade in the same direction instead of jumping to opaque. -->
            <SolidColorBrush x:Key="GlassHairlineBrush" Color="#3DFFFFFF" />
            <SolidColorBrush x:Key="GlassSurfaceHoverBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="GlassInputBrush" Color="#16FFFFFF" />
            <SolidColorBrush x:Key="GlassPanelFallbackBrush" Color="#B40E1420" />
            <AcrylicBrush x:Key="GlassButtonBrush"
                          TintColor="#FF243149"
                          TintOpacity="0.16"
                          TintLuminosityOpacity="0.34"
                          FallbackColor="#A62A3446" />
            <!-- The accent button keeps more of its own colour than the neutral
                 surfaces do: it is the one control that has to stay findable
                 against any wallpaper, and a primary action that dissolves into
                 the background is a worse outcome than a slightly denser one. -->
            <AcrylicBrush x:Key="AccentGlassButtonBrush"
                          TintColor="#FF2D6BEA"
                          TintOpacity="0.40"
                          TintLuminosityOpacity="0.58"
                          FallbackColor="#D93F70D9" />
            <AcrylicBrush x:Key="GlassPanelBrush"
                          TintColor="#FF111827"
                          TintOpacity="0.18"
                          TintLuminosityOpacity="0.34"
                          FallbackColor="#B4101725" />
            <AcrylicBrush x:Key="GlassCardBrush"
                          TintColor="#FF172033"
                          TintOpacity="0.14"
                          TintLuminosityOpacity="0.28"
                          FallbackColor="#A6141C2E" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#42FFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#B8C3D5" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FFFFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="SolidAppBackgroundBrush" Color="#FFF1F4F9" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF121722" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF596579" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF778297" />
            <!-- Same retune as Dark. Light glass needs a little more luminosity
                 than dark does - dark text over a bright, busy wallpaper loses
                 contrast far faster than light text does - so these sit around
                 0.45 rather than the 0.30 used above. -->
            <SolidColorBrush x:Key="GlassHairlineBrush" Color="#5CFFFFFF" />
            <SolidColorBrush x:Key="GlassSurfaceHoverBrush" Color="#59FFFFFF" />
            <SolidColorBrush x:Key="GlassInputBrush" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="GlassPanelFallbackBrush" Color="#BFF7F9FC" />
            <AcrylicBrush x:Key="GlassButtonBrush"
                          TintColor="#FFFFFFFF"
                          TintOpacity="0.22"
                          TintLuminosityOpacity="0.48"
                          FallbackColor="#B8F5F8FC" />
            <AcrylicBrush x:Key="AccentGlassButtonBrush"
                          TintColor="#FF4F83EF"
                          TintOpacity="0.40"
                          TintLuminosityOpacity="0.64"
                          FallbackColor="#D95584E8" />
            <AcrylicBrush x:Key="GlassPanelBrush"
                          TintColor="#FFF6F8FC"
                          TintOpacity="0.24"
                          TintLuminosityOpacity="0.46"
                          FallbackColor="#BFF7F9FC" />
            <AcrylicBrush x:Key="GlassCardBrush"
                          TintColor="#FFFFFFFF"
                          TintOpacity="0.18"
                          TintLuminosityOpacity="0.42"
                          FallbackColor="#B8F8FAFD" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#1F3F70D9" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#2E3F70D9" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="#0F121722" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="#FF4A5568" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#FF121722" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="#FF121722" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="SolidAppBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassHairlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="GlassSurfaceHoverBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassInputBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassPanelFallbackBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassButtonBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AccentGlassButtonBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GlassPanelBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="GlassCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="{ThemeResource SystemColorHighlightTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="Accent">#5B8CFF</Color>
    <Color x:Key="Danger">#FF5B52</Color>
    <Color x:Key="Warning">#FFAA24</Color>
    <Color x:Key="Info">#8A7DFF</Color>
    <Color x:Key="Success">#35D071</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />

    <!-- Fresnel-like edge and top glare, adapted from the referenced web implementations. -->
    <LinearGradientBrush x:Key="LiquidEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A6FFFFFF" Offset="0" />
        <GradientStop Color="#24FFFFFF" Offset="0.28" />
        <GradientStop Color="#0AFFFFFF" Offset="0.62" />
        <GradientStop Color="#4D9FC3FF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidPrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF73A2FF" Offset="0" />
        <GradientStop Color="#FF3F6FE8" Offset="0.52" />
        <GradientStop Color="#FF315AC6" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidButtonEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFFFFF" Offset="0" />
        <GradientStop Color="#70FFFFFF" Offset="0.26" />
        <GradientStop Color="#1FFFFFFF" Offset="0.58" />
        <GradientStop Color="#B28CCBFF" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="LiquidInnerHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#78FFFFFF" Offset="0" />
        <GradientStop Color="#12FFFFFF" Offset="0.38" />
        <GradientStop Color="#00FFFFFF" Offset="0.72" />
        <GradientStop Color="#1A8EBEFF" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="LiquidGlareBrush" Center="0.42,0" GradientOrigin="0.42,0" RadiusX="0.75" RadiusY="1.2">
        <GradientStop Color="#70FFFFFF" Offset="0" />
        <GradientStop Color="#16FFFFFF" Offset="0.42" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>

    <Style x:Key="GlassCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassCardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LiquidEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1.25" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="22" />
    </Style>

    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="38" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <Style x:Key="SubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="0,4,0,20" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
    </Style>

    <!-- Complete template keeps the system Button behavior while replacing its flat chrome. -->
    <Style x:Key="LiquidGlassButtonBaseStyle" TargetType="Button">
        <Setter Property="BorderBrush" Value="{StaticResource LiquidButtonEdgeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <!-- Rounded rectangle, not a full pill/oval (was 999). Every button in the app
             (Quick docket, Add files, Refresh, etc.) shares this base style, so this one
             value controls the shape everywhere. -->
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="17,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="RootGrid"
                          Background="Transparent"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.16" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="OuterGlow.Opacity" Value="0.42" />
                                        <Setter Target="TopGlare.Opacity" Value="0.82" />
                                        <Setter Target="HoverWash.Opacity" Value="0.18" />
                                        <Setter Target="ButtonScale.ScaleX" Value="1.025" />
                                        <Setter Target="ButtonScale.ScaleY" Value="1.025" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="OuterGlow.Opacity" Value="0.12" />
                                        <Setter Target="TopGlare.Opacity" Value="0.35" />
                                        <Setter Target="PressedShade.Opacity" Value="0.16" />
                                        <Setter Target="ButtonScale.ScaleX" Value="0.975" />
                                        <Setter Target="ButtonScale.ScaleY" Value="0.975" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="RootGrid.Opacity" Value="0.42" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.12" />
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Border x:Name="OuterGlow"
                                Margin="-3"
                                Background="#2F76B8FF"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0.24" />
                        <Border x:Name="Substrate"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border Margin="1"
                                Background="{StaticResource LiquidInnerHighlightBrush}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0.66" />
                        <Border x:Name="HoverWash"
                                Margin="1"
                                Background="#FFFFFFFF"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0" />
                        <Border x:Name="PressedShade"
                                Margin="1"
                                Background="#FF07101E"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Opacity="0" />
                        <Border x:Name="TopGlare"
                                Height="14"
                                Margin="5,3,5,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource LiquidGlareBrush}"
                                CornerRadius="999"
                                Opacity="0.62" />
                        <ContentPresenter x:Name="ContentPresenter"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentTransitions="{TemplateBinding ContentTransitions}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <Border x:Name="FocusRing"
                                Margin="-3"
                                BorderBrush="{ThemeResource SystemControlHighlightAccentBrush}"
                                BorderThickness="2"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LiquidButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource LiquidGlassButtonBaseStyle}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{ThemeResource AccentGlassButtonBrush}" />
        <Setter Property="Padding" Value="18,9" />
    </Style>

    <Style x:Key="GlassButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource LiquidGlassButtonBaseStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{ThemeResource GlassButtonBrush}" />
    </Style>

    <Style x:Key="GlassTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{ThemeResource GlassInputBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
    </Style>

    <Style x:Key="PillBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassInputBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassHairlineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="11,5" />
    </Style>

</ResourceDictionary>
