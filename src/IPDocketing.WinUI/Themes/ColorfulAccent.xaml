<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Overrides the flat single-blue accent from LiquidGlass.xaml with a
         richer, more vivid palette. Merged in AFTER LiquidGlass.xaml at
         startup (see App.xaml.cs) only when "Colorful" is the saved theme,
         so these keys win for any duplicate name via normal WinUI merged-
         dictionary resolution - no dynamic runtime brush-swapping involved,
         just plain XAML resource layering, applied before any page is
         constructed. Base light/dark contrast still comes from LiquidGlass's
         ThemeDictionaries (Colorful applies on top of Dark) - this file only
         touches the accent/status colors, not text/background contrast. -->

    <Color x:Key="Accent">#FF7A3DF5</Color>
    <Color x:Key="Danger">#FFFF5C8A</Color>
    <Color x:Key="Warning">#FFFFA23D</Color>
    <Color x:Key="Info">#FF3DD0F5</Color>
    <Color x:Key="Success">#FF2FE0A0</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />

    <LinearGradientBrush x:Key="LiquidPrimaryBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFB56CFF" Offset="0" />
        <GradientStop Color="#FF7A3DF5" Offset="0.5" />
        <GradientStop Color="#FFE83DA8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B0FFD9F0" Offset="0" />
        <GradientStop Color="#30FFC7ED" Offset="0.28" />
        <GradientStop Color="#0AB56CFF" Offset="0.62" />
        <GradientStop Color="#66E83DA8" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="LiquidButtonEdgeBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F2FFE8FA" Offset="0" />
        <GradientStop Color="#80FFB0E0" Offset="0.26" />
        <GradientStop Color="#40E83DA8" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
