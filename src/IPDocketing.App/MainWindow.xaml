<Window x:Class="IPDocketing.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:IPDocketing.App.ViewModels"
        xmlns:views="clr-namespace:IPDocketing.App.Views"
        Title="IP Docketing - Enterprise Portfolio &amp; Deadline Management by Anant Goel"
        Height="820" Width="1360" MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/app.ico"
        Background="Transparent">

    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{Binding NavItems[1]}" />
        <KeyBinding Key="D" Modifiers="Control" Command="{Binding NavigateCommand}"
                    CommandParameter="{Binding NavItems[2]}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MattersViewModel}">
            <views:MattersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeadlinesViewModel}">
            <views:DeadlinesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PtoSyncViewModel}">
            <views:PtoSyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <views:DocumentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
            <views:ReportsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Glass sidebar -->
        <Border Grid.Column="0" Background="{StaticResource NavRailBrush}"
                BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,16,20">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource BrandAccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,10,0">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.7" Color="#3B82F6" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock Text="IP Docketing" Foreground="White" FontWeight="SemiBold"
                               FontSize="15" VerticalAlignment="Center" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding NavItems}" Margin="0,0,0,16">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource NavRailButtonStyle}" HorizontalAlignment="Stretch"
                                    Command="{Binding DataContext.NavigateCommand,
                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Button.Tag>
                                    <MultiBinding Converter="{x:Static views:NavActiveConverter.Instance}">
                                        <Binding Path="." />
                                        <Binding Path="DataContext.SelectedNavItem"
                                                 RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </MultiBinding>
                                </Button.Tag>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets"
                                               Width="22" Margin="0,0,12,0" FontSize="15" />
                                    <TextBlock Text="{Binding Label}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Main column: glass header + content + status -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Glass header -->
            <Border Grid.Row="0" Background="{StaticResource HeaderGlassBrush}"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel Margin="24,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTime}" Foreground="{StaticResource NavRailTextBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,18,0"
                                   FontFamily="Consolas, Cascadia Mono, Segoe UI" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource CompletedBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding SyncStatusText}" Foreground="{StaticResource NavRailTextBrush}"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Content="+ Quick Docket" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding NavigateCommand}" CommandParameter="{Binding NavItems[2]}" />
                    </StackPanel>
                    <TextBox Width="320" VerticalAlignment="Center"
                             Style="{StaticResource GlassTextBoxStyle}"
                             Tag="Search matters, deadlines..." />
                </DockPanel>
            </Border>

            <!-- Workspace -->
            <Grid Grid.Row="1" Background="#990B0F19">
                <ContentControl Content="{Binding CurrentView}" />
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="#0E121C"
                    BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,1,0,0">
                <DockPanel Margin="16,0">
                    <TextBlock DockPanel.Dock="Right" Text="Developed by Anant Goel" FontSize="11"
                               VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Local DB: synced" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,18,0" />
                        <TextBlock Text="{Binding PtoConnectivityText}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,18,0" />
                        <TextBlock Text="{Binding OcrStatusText}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
