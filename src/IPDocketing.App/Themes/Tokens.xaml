<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Theme: Liquid Glass (Apple-inspired)
         Deep radial backdrop + translucent surfaces, soft borders,
         luminous status accents. Classic WPF approximation of
         backdrop-filter glass (true OS acrylic needs WinUI/Mica).
         ============================================================ -->

    <Color x:Key="BackgroundLightColor">#F0F2F7</Color>
    <Color x:Key="BackgroundDarkColor">#0B0F19</Color>
    <Color x:Key="SurfaceLightColor">#FFFFFF</Color>
    <Color x:Key="SurfaceDarkColor">#151C2E</Color>

    <!-- Brand – bright indigo like liquid primary -->
    <Color x:Key="BrandAccentColor">#3B82F6</Color>
    <Color x:Key="BrandAccentHoverColor">#60A5FA</Color>

    <!-- Apple-like system status colors -->
    <Color x:Key="OverdueColor">#FF453A</Color>
    <Color x:Key="UpcomingColor">#FF9F0A</Color>
    <Color x:Key="PendingPtoColor">#5E5CE6</Color>
    <Color x:Key="CompletedColor">#30D158</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundDarkColor}" />
    <!-- Glass surface: slightly lifted panel -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="SurfaceSolidBrush" Color="#151C2E" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="{StaticResource BrandAccentHoverColor}" />

    <SolidColorBrush x:Key="OverdueBrush" Color="{StaticResource OverdueColor}" />
    <SolidColorBrush x:Key="UpcomingBrush" Color="{StaticResource UpcomingColor}" />
    <SolidColorBrush x:Key="PendingPtoBrush" Color="{StaticResource PendingPtoColor}" />
    <SolidColorBrush x:Key="CompletedBrush" Color="{StaticResource CompletedColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#99A0B3" />

    <!-- Hairline glass border -->
    <SolidColorBrush x:Key="BorderBrush1" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#33FFFFFF" />

    <!-- Sidebar / chrome -->
    <SolidColorBrush x:Key="NavRailBrush" Color="#E60E121C" />
    <SolidColorBrush x:Key="NavRailTextBrush" Color="#A6ADC8" />
    <SolidColorBrush x:Key="NavRailHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="NavRailActiveBrush" Color="#30FFFFFF" />

    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1A2240" />
    <SolidColorBrush x:Key="HeaderGlassBrush" Color="#990B0F19" />

    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="AppFontFamilyDisplay">Segoe UI Variable Display, Segoe UI Semibold</FontFamily>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeTitle">24</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeSubtitle">14</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeBody">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeCaption">11</sys:Double>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DataRowHeight">36</sys:Double>

    <CornerRadius x:Key="CardCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
    <CornerRadius x:Key="NavItemCornerRadius">12</CornerRadius>

</ResourceDictionary>
