<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Theme: Midnight Indigo (Dark Mode)
         Deep, low-glare dark UI for long docketing sessions.
         ============================================================ -->

    <!-- ===================== Surface colors ===================== -->
    <Color x:Key="BackgroundLightColor">#F0F2F7</Color>   <!-- kept for reference / future toggle -->
    <Color x:Key="BackgroundDarkColor">#0B0E18</Color>    <!-- near-black indigo -->
    <Color x:Key="SurfaceLightColor">#FFFFFF</Color>
    <Color x:Key="SurfaceDarkColor">#151A2C</Color>       <!-- elevated card surface -->

    <!-- ===================== Brand / accent ===================== -->
    <Color x:Key="BrandAccentColor">#5C7CFA</Color>       <!-- soft bright indigo -->
    <Color x:Key="BrandAccentHoverColor">#748FFC</Color>  <!-- lighter on hover -->

    <!-- ===================== Urgency / status colors ===================== -->
    <Color x:Key="OverdueColor">#FF6B6B</Color>           <!-- softer red for dark bg -->
    <Color x:Key="UpcomingColor">#FFA94D</Color>          <!-- warm amber -->
    <Color x:Key="PendingPtoColor">#9775FA</Color>        <!-- soft violet -->
    <Color x:Key="CompletedColor">#51CF66</Color>         <!-- soft green -->

    <!-- ===================== Brushes (DARK MODE ACTIVE) ===================== -->
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundDarkColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceDarkColor}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}" />
    <SolidColorBrush x:Key="BrandAccentHoverBrush" Color="{StaticResource BrandAccentHoverColor}" />

    <SolidColorBrush x:Key="OverdueBrush" Color="{StaticResource OverdueColor}" />
    <SolidColorBrush x:Key="UpcomingBrush" Color="{StaticResource UpcomingColor}" />
    <SolidColorBrush x:Key="PendingPtoBrush" Color="{StaticResource PendingPtoColor}" />
    <SolidColorBrush x:Key="CompletedBrush" Color="{StaticResource CompletedColor}" />

    <!-- Text (light on dark) -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8EAF2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B92A8" />

    <!-- Borders & dividers -->
    <SolidColorBrush x:Key="BorderBrush1" Color="#2A3148" />

    <!-- Navigation rail (slightly deeper than content) -->
    <SolidColorBrush x:Key="NavRailBrush" Color="#080B14" />
    <SolidColorBrush x:Key="NavRailTextBrush" Color="#A8B0C8" />
    <SolidColorBrush x:Key="NavRailHoverBrush" Color="#1A2038" />
    <SolidColorBrush x:Key="NavRailActiveBrush" Color="#5C7CFA" />

    <!-- Subtle accent for cards / highlights -->
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1A2240" />

    <!-- ===================== Typography ===================== -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="AppFontFamilyDisplay">Segoe UI Variable Display, Segoe UI Semibold</FontFamily>

    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeTitle">22</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeSubtitle">15</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeBody">13</sys:Double>
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="FontSizeCaption">11</sys:Double>

    <!-- Compact row height for high-density data grids -->
    <sys:Double xmlns:sys="clr-namespace:System;assembly=mscorlib" x:Key="DataRowHeight">32</sys:Double>

    <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>

</ResourceDictionary>
