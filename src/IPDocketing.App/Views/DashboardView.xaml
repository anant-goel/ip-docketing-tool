<UserControl x:Class="IPDocketing.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IPDocketing.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32">
        <StackPanel>
            <TextBlock Text="Dashboard" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Portfolio-wide deadline health at a glance." Style="{StaticResource SubtitleStyle}" />

            <UniformGrid Columns="4" Rows="1" Margin="0,0,0,28">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Overdue" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding OverdueCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource OverdueBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Upcoming (14 days)" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding UpcomingCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource UpcomingBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,14,0">
                    <StackPanel>
                        <TextBlock Text="Pending PTO Response" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding PendingCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource PendingPtoBrush}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Completed" FontSize="13" FontWeight="Medium"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding CompletedCount}" FontSize="36" FontWeight="Bold"
                                   Foreground="{StaticResource CompletedBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Text="Nearest deadlines" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,12"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <Border Style="{StaticResource CardStyle}" Padding="8,4">
                <ItemsControl ItemsSource="{Binding TopDeadlines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="12,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                                             Fill="{Binding Converter={StaticResource UrgencyToBrushConverter}}" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Matter.MatterNumber}" FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DueDate, StringFormat=d}"
                                               VerticalAlignment="Center" Margin="0,0,20,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <Border Grid.Column="3" Style="{StaticResource StatusPillStyle}"
                                            Background="#28FFFFFF" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding Converter={StaticResource UrgencyToLabelConverter}}"
                                                   Foreground="{Binding Converter={StaticResource UrgencyToBrushConverter}}"
                                                   FontSize="12" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
