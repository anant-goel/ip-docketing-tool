<UserControl x:Class="IPDocketing.App.Views.PtoSyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:IPDocketing.App.ViewModels"
             d:DataContext="{d:DesignInstance vm:PtoSyncViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008/design"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="PTO Sync" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Grid.Row="0" Margin="0,28,0,16" VerticalAlignment="Bottom"
                   Text="Automated ingestion of Official Actions and Notices from USPTO (TSDR/PAIR), EPO, and WIPO."
                   Style="{StaticResource SubtitleStyle}" />

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Connection" FontWeight="SemiBold" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <ComboBox Width="140" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}"
                              Margin="0,0,10,0" Padding="6" />
                    <Button Content="Connect" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding ConnectCommand}" Margin="0,0,10,0" />
                    <Button Content="Sync Now" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding SyncCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding ConnectivityStatus}" Margin="0,10,0,0"
                            Foreground="{StaticResource TextSecondaryBrush}" />
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                           Text="This build ships the sync architecture without live office credentials. Implement IPtoSyncClient per office and register API keys to enable real ingestion of Official Actions/Notices into the Documents and Deadlines modules." />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Sync log" FontWeight="SemiBold" Margin="0,0,0,10" />
                <ListBox ItemsSource="{Binding SyncLog}" BorderThickness="0" Background="Transparent"
                         FontFamily="Consolas" FontSize="12" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
