<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match IPDocketing.Core exactly. Core is net8.0-windows (it uses
         DPAPI via System.Security.Cryptography.ProtectedData), so a plain
         net8.0 test project cannot reference it. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>IPDocketing.Core.Tests</RootNamespace>

    <!-- These tests are deliberately reference-only against the Core library.
         Nothing here touches WinUI, WebView2 or the live portal, so the suite
         runs on any Windows machine without a browser, without network access
         and without the app installed. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\IPDocketing.Core\IPDocketing.Core.csproj" />
  </ItemGroup>

</Project>
